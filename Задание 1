def ways_num(graph, start, end):
    if start == end:
            return 1
    if start == None:
         return 0
    else:
        count = 0
        for neighbour in graph[start]:
            count += ways_num(graph, neighbour, end)
        return count


graph = {
    '1':['2','3','4','5'],
    '2':['3','6'],
    '3':['6','8'],
    '4':['3','8'],
    '5':['4','8','9'],
    '6':['8','7'],
    '7':[None],
    '8':['7'],
    '9':['7','8'],
}

print(ways_num(graph, '1', '3') * ways_num(graph, '3', '7'))
